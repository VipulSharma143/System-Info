# DEPRECATED — no longer staged into the .deb/.AppImage. `tauri build`
# generates its own .desktop entry (from tauri.conf.json's productName/
# identifier/category) pointing at the real Tauri binary. Kept only for
# reference. See .github/workflows/release.yml's build-linux job.
[Desktop Entry]
Type=Application
Name=SystemInfo
Comment=Multi-language system performance monitor
Exec=start-all.sh
Icon=systeminfo
Terminal=true
Categories=System;Monitor;
