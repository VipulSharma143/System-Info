#!/bin/bash
# DEPRECATED — no longer used by the production build.
#
# The Linux .deb/.AppImage packages are now built by `tauri build` (see
# .github/workflows/release.yml's build-linux job), which bundles the
# Tauri desktop shell directly — a proper native window, not this script
# execing start-all.sh's dev-oriented `dotnet run`/`npm run dev`/bare
# `uvicorn` flow inside a terminal. Kept only for reference; not staged
# into any package anymore. See frontend/src-tauri/ for the real launcher
# (src/process.rs) and packaging.
#
# AppRun — entry point invoked automatically when SystemInfo.AppImage is run.
#
# AppImages mount themselves as a read-only squashfs at runtime, so logs/
# can't live inside the bundle. This redirects logging to a normal writable
# location under the user's home directory instead, via the same
# SYSTEMINFO_LOG_DIR override that start-all.sh was patched to respect.

HERE="$(dirname "$(readlink -f "${0}")")"

export SYSTEMINFO_LOG_DIR="$HOME/.local/share/systeminfo/logs"
mkdir -p "$SYSTEMINFO_LOG_DIR"

exec "$HERE/usr/share/systeminfo/start-all.sh" "$@"
