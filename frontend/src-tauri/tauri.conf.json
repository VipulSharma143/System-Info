{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SystemInfo",
  "version": "2.2.2",
  "identifier": "dev.vipulsharma.systeminfo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "System Info",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 650,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "center": true,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "publisher": "Vipul Sharma",
    "copyright": "Copyright © Vipul Sharma",
    "category": "Utility",
    "shortDescription": "Multi-language system performance monitor",
    "longDescription": "A full-stack system monitor reading CPU, memory, disk, network, and process data directly from kernel interfaces, with a native C++/Assembly engine, Python analytics, and a React dashboard.",
    "targets": [
      "nsis",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/backend/**/*": "backend/",
      "resources/analytics/**/*": "analytics/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2MEM1OEM4OERCNEM4REIKUldUYnlMU055RmdNaGp0RThqUGlUMEMvbkdER3N2WWRZb1B3d3VuNDE3MnZvTllQYXRJUG9wRDIK",
      "endpoints": [
        "https://github.com/VipulSharma143/System-Info/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
