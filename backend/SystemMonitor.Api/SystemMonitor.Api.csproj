<Project Sdk="Microsoft.NET.Sdk.Web">

<PropertyGroup>
<TargetFramework>net10.0</TargetFramework>
<Nullable>enable</Nullable>
<ImplicitUsings>enable</ImplicitUsings>

<!-- Production packaging: `dotnet publish -c Release -r win-x64` produces a
     self-contained folder that runs on a clean Windows PC with no .NET
     runtime/SDK installed. Not single-file, since systemmonitor_native.dll
     needs to sit next to the exe as a normal loadable native library. -->
<SelfContained>true</SelfContained>
<RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
<PublishSingleFile>false</PublishSingleFile>
<InvariantGlobalization>true</InvariantGlobalization>
</PropertyGroup>

<ItemGroup>
<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
<PackageReference Include="MongoDB.Driver" Version="3.11.1" />
<PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.11" />
<PackageReference Include="System.Management" Version="10.0.11" />
</ItemGroup>

<ItemGroup Condition="'$(OS)' != 'Windows_NT'">
<None Include="libsystemmonitor_native.so" CopyToOutputDirectory="PreserveNewest" Condition="Exists('libsystemmonitor_native.so')" />
</ItemGroup>
<ItemGroup Condition="'$(OS)' == 'Windows_NT'">
<None Include="systemmonitor_native.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('systemmonitor_native.dll')" />
</ItemGroup>

<!-- wwwroot is populated by the CI workflow (a plain file copy of frontend/dist
     into wwwroot, run BEFORE `dotnet publish`) — see
     .github/workflows/build-windows-installer.yml. It is NOT done via an
     MSBuild Target here: BeforeTargets="Publish" runs too late — the SDK
     decides which files under wwwroot count as publishable content when the
     project is first EVALUATED, before any target (including a Publish-time
     copy) executes. A target-based copy silently produces an empty
     wwwroot in the publish output. Files just need to already be on disk in
     wwwroot before `dotnet publish` is invoked; the SDK then publishes them
     automatically like any other ASP.NET Core static content. -->

</Project>